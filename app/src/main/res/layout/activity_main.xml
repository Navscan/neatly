<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="48dp">

        <!-- Header: title + ABV/Proof toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="40sp"
                android:fontFamily="serif"
                android:letterSpacing="-0.02" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/unitToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/tint"
                app:tabIndicatorColor="@color/accent_dark"
                app:tabIndicatorHeight="0dp"
                app:tabSelectedTextColor="@color/on_accent"
                app:tabTextColor="@color/ink_muted"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabPaddingStart="16dp"
                app:tabPaddingEnd="16dp">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_abv" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_proof" />
            </com.google.android.material.tabs.TabLayout>
        </LinearLayout>

        <!-- Tagline -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tagline"
            android:textColor="@color/ink_muted"
            android:textSize="15sp"
            android:layout_marginBottom="24dp" />

        <!-- Main tabs: Cut / 100 L / Flavour -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/mainTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tint"
            app:tabIndicatorColor="@color/accent_dark"
            app:tabIndicatorHeight="0dp"
            app:tabSelectedTextColor="@color/on_accent"
            app:tabTextColor="@color/ink_muted"
            app:tabMode="fixed"
            app:tabGravity="fill"
            android:layout_marginBottom="20dp">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_cut" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_100l" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_flavour" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Cut card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Sub-tabs: Volume / On hand / Blend -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/subTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/tint"
                    app:tabIndicatorColor="@color/accent_dark"
                    app:tabIndicatorHeight="0dp"
                    app:tabSelectedTextColor="@color/on_accent"
                    app:tabTextColor="@color/ink_muted"
                    app:tabMode="fixed"
                    app:tabGravity="fill"
                    android:layout_marginBottom="20dp">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subtab_volume" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subtab_onhand" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subtab_blend" />
                </com.google.android.material.tabs.TabLayout>

                <!-- Volume input -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Neatly.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_first_volume"
                    android:layout_marginBottom="18dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sourceVolume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/ink"
                        android:textSize="22sp"
                        android:fontFamily="serif" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Source strength -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Neatly.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_first_strength"
                    android:layout_marginBottom="18dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sourceAbv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/ink"
                        android:textSize="22sp"
                        android:fontFamily="serif" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Target strength -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Neatly.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_target_strength"
                    android:layout_marginBottom="20dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/targetAbv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/ink"
                        android:textSize="22sp"
                        android:fontFamily="serif" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calculateBtn"
                    style="@style/Neatly.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_calculate" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Results card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/results_title"
                    android:textColor="@color/ink_muted"
                    android:textSize="18sp"
                    android:fontFamily="serif"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/result_water_to_add"
                        android:textColor="@color/ink_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/resWater"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink"
                        android:textSize="24sp"
                        android:fontFamily="serif" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/result_final_volume"
                        android:textColor="@color/ink_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/resFinalVol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink"
                        android:textSize="24sp"
                        android:fontFamily="serif" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/result_pure_alcohol"
                        android:textColor="@color/ink_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/resPureAlc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink"
                        android:textSize="24sp"
                        android:fontFamily="serif" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/result_contraction"
                        android:textColor="@color/ink_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/resContraction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink"
                        android:textSize="24sp"
                        android:fontFamily="serif" />
                </LinearLayout>

                <TextView
                    android:id="@+id/resWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink_light"
                    android:textSize="13sp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
