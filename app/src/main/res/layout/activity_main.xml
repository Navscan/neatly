<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/wordmarkText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="38sp"
                android:textColor="@color/ink"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/pill_container"
                    android:padding="3dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/unitAbv"
                        android:layout_width="56dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="@string/unit_abv"
                        android:textSize="11sp"
                        android:textColor="@color/on_accent"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:background="@drawable/pill_active" />

                    <TextView
                        android:id="@+id/unitProof"
                        android:layout_width="56dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="@string/unit_proof"
                        android:textSize="11sp"
                        android:textColor="@color/ink_muted"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/pill_container"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/unitMetric"
                        android:layout_width="56dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="@string/unit_metric"
                        android:textSize="11sp"
                        android:textColor="@color/on_accent"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:background="@drawable/pill_active" />

                    <TextView
                        android:id="@+id/unitImperial"
                        android:layout_width="56dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="@string/unit_imperial"
                        android:textSize="11sp"
                        android:textColor="@color/ink_muted"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tagline"
            android:textColor="@color/ink_muted"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="22dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/pill_container"
            android:padding="3dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/tabCut"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_cut"
                android:textSize="13sp"
                android:textColor="@color/on_accent"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:background="@drawable/pill_active" />

            <TextView
                android:id="@+id/tab100l"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_100l"
                android:textSize="13sp"
                android:textColor="@color/ink_muted"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tabFlavour"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_flavour"
                android:textSize="13sp"
                android:textColor="@color/ink_muted"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/pill_container"
                    android:padding="3dp"
                    android:layout_marginBottom="22dp">

                    <TextView
                        android:id="@+id/subVolume"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/subtab_volume"
                        android:textSize="12sp"
                        android:textColor="@color/on_accent"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.03"
                        android:background="@drawable/pill_active" />

                    <TextView
                        android:id="@+id/subOnHand"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/subtab_onhand"
                        android:textSize="12sp"
                        android:textColor="@color/ink_muted"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.03" />

                    <TextView
                        android:id="@+id/subBlend"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/subtab_blend"
                        android:textSize="12sp"
                        android:textColor="@color/ink_muted"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.03" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_first_volume"
                        android:textSize="13sp"
                        android:textColor="@color/ink_muted"
                        android:letterSpacing="0.02" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <EditText
                            android:id="@+id/sourceVolume"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="28sp"
                            android:textColor="@color/ink"
                            android:fontFamily="@font/playfair_display"
                            android:background="@null"
                            android:paddingTop="4dp"
                            android:paddingBottom="6dp"
                            android:inputType="numberDecimal"
                            android:importantForAutofill="no"
                            android:hint="0" />

                        <TextView
                            android:id="@+id/unitVolume"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/unit_liters"
                            android:textSize="13sp"
                            android:textColor="@color/ink_light"
                            android:letterSpacing="0.04"
                            android:paddingBottom="10dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_strong" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_first_strength"
                        android:textSize="13sp"
                        android:textColor="@color/ink_muted"
                        android:letterSpacing="0.02" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <EditText
                            android:id="@+id/sourceAbv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="28sp"
                            android:textColor="@color/ink"
                            android:fontFamily="@font/playfair_display"
                            android:background="@null"
                            android:paddingTop="4dp"
                            android:paddingBottom="6dp"
                            android:inputType="numberDecimal"
                            android:importantForAutofill="no"
                            android:hint="0" />

                        <TextView
                            android:id="@+id/unitSourceStrength"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/unit_abv"
                            android:textSize="13sp"
                            android:textColor="@color/ink_light"
                            android:letterSpacing="0.04"
                            android:paddingBottom="10dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_strong" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_target_strength"
                        android:textSize="13sp"
                        android:textColor="@color/ink_muted"
                        android:letterSpacing="0.02" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <EditText
                            android:id="@+id/targetAbv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="28sp"
                            android:textColor="@color/ink"
                            android:fontFamily="@font/playfair_display"
                            android:background="@null"
                            android:paddingTop="4dp"
                            android:paddingBottom="6dp"
                            android:inputType="numberDecimal"
                            android:importantForAutofill="no"
                            android:hint="0" />

                        <TextView
                            android:id="@+id/unitTargetStrength"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/unit_abv"
                            android:textSize="13sp"
                            android:textColor="@color/ink_light"
                            android:letterSpacing="0.04"
                            android:paddingBottom="10dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_strong" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/results_title"
                    android:textSize="22sp"
                    android:textColor="@color/ink"
                    android:fontFamily="@font/playfair_display"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/result_water_to_add"
                        android:textSize="15sp"
                        android:textColor="@color/ink_muted" />

                    <TextView
                        android:id="@+id/resWater"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:textColor="@color/ink"
                        android:fontFamily="@font/playfair_display" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/result_final_volume"
                        android:textSize="15sp"
                        android:textColor="@color/ink_muted" />

                    <TextView
                        android:id="@+id/resFinalVol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:textColor="@color/ink"
                        android:fontFamily="@font/playfair_display" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/result_pure_alcohol"
                        android:textSize="15sp"
                        android:textColor="@color/ink_muted" />

                    <TextView
                        android:id="@+id/resPureAlc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:textColor="@color/ink"
                        android:fontFamily="@font/playfair_display" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/result_contraction"
                        android:textSize="15sp"
                        android:textColor="@color/ink_muted" />

                    <TextView
                        android:id="@+id/resContraction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:textColor="@color/ink"
                        android:fontFamily="@font/playfair_display" />
                </LinearLayout>

                <TextView
                    android:id="@+id/resWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/ink_light"
                    android:layout_marginTop="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/updateBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/accent_dark"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:gravity="center"
                android:text="@string/update_ready"
                android:textColor="@color/on_accent"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.03" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/footerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:textSize="11sp"
            android:textColor="@color/ink_light"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.08"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
