<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Neatly" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/accent_dark</item>
        <item name="colorPrimaryVariant">@color/accent_dark_hover</item>
        <item name="colorOnPrimary">@color/on_accent</item>

        <item name="colorSecondary">@color/ink</item>
        <item name="colorSecondaryVariant">@color/ink_muted</item>
        <item name="colorOnSecondary">@color/on_accent</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/ink</item>

        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
    </style>

    <!-- Tab text appearance: pill-style segmented control -->
    <style name="Neatly.TabText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Label above input -->
    <style name="Neatly.InputLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Input value: display serif, large -->
    <style name="Neatly.InputValue">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/cormorant_garamond</item>
        <item name="android:background">@null</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:inputType">numberDecimal</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <!-- Unit suffix next to value -->
    <style name="Neatly.UnitSuffix">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_light</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Result number: display serif, larger -->
    <style name="Neatly.ResultValue">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/cormorant_garamond</item>
    </style>

    <!-- Result label -->
    <style name="Neatly.ResultLabel">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Footer -->
    <style name="Neatly.Footer">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/ink_light</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAlignment">center</item>
        <item name="android:layout_gravity">center_horizontal</item>
    </style>

</resources>
